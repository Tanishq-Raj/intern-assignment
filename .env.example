# Netflix Catalog Q&A System Configuration

# Database path (defaults to data/netflix.db if unset)
DATABASE_PATH=data/netflix.db

# LLM Provider Configuration: "auto", "openai", "groq", or "offline"
# If no API key is provided, the system seamlessly uses offline grounded generation.
LLM_PROVIDER=auto

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=

# Groq Configuration (Free tier supported via OpenAI compatibility)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
